#!/usr/bin/env bash
#
#  Keep VENDOR.txt's checksums in sync with whatever's actually being
#  committed. The CI 'pins' workflow (.github/workflows/pins.yml) only
#  catches a stale pin after the fact; this fixes it before the commit
#  lands, since that's bitten this repo twice already.
#
#  Mirrors the CI script's own parsing: read VENDOR.txt line by line,
#  skip blank/prose lines, and for every line that looks like a
#  "<sha256>  <path>" pin, re-pin it if that path is staged in this
#  commit and its checksum has drifted.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

VENDOR_FILE="VENDOR.txt"
[ -f "$VENDOR_FILE" ] || exit 0

staged_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    git show ":$1" | sha256sum | awk '{print $1}'
  else
    git show ":$1" | shasum -a 256 | awk '{print $1}'
  fi
}

changed=0
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

while IFS= read -r line || [ -n "$line" ]; do
  sum="$(printf '%s' "$line" | awk '{print $1}')"
  path="$(printf '%s' "$line" | awk '{print $2}')"

  case "$sum" in
  '' | ::*)
    printf '%s\n' "$line" >>"$tmp"
    continue
    ;;
  esac
  if ! printf '%s' "$sum" | grep -qE '^[0-9a-f]{64}$'; then
    printf '%s\n' "$line" >>"$tmp"
    continue
  fi

  if git diff --cached --name-only --diff-filter=ACM | grep -qxF "$path"; then
    new_sum="$(staged_sha256 "$path")"
    if [ "$new_sum" != "$sum" ]; then
      echo "pre-commit: re-pinning $path in $VENDOR_FILE ($sum -> $new_sum)"
      printf '%s  %s\n' "$new_sum" "$path" >>"$tmp"
      changed=1
      continue
    fi
  fi
  printf '%s\n' "$line" >>"$tmp"
done <"$VENDOR_FILE"

if [ "$changed" -eq 1 ]; then
  cp "$tmp" "$VENDOR_FILE"
  git add "$VENDOR_FILE"
fi
